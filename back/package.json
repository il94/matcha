{
	"scripts": {
		"start": "NODE_ENV=production node src/index.js",
		"dev": "nodemon -w src -e ts,json --exec \"tsx src/index.ts\"",
		"format": "prettier --write .",
		"check": "eslint . && tsc -p ./tsconfig.json",
		"format:check": "npm run format && npm run check"
	},
	"dependencies": {
		"fastify": "^5.2.1",
		"fastify-cors": "^6.0.3",
		"fastify-multipart": "^5.3.1"
	},
	"devDependencies": {
		"@types/node": "^22.10.5",
		"eslint": "^8.57.1",
		"nodemon": "^3.1.9",
		"prettier": "^3.4.2",
		"tsx": "^4.19.2",
		"typescript": "^5.7.3"
	}
}
